DJANGO_DEBUG=1
DJANGO_SECRET_KEY=replace-with-a-random-secret-at-least-50-characters
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Kosong: SQLite lokal. PostgreSQL direkomendasikan untuk akses bersamaan.
DATABASE_URL=
# Opsional lokal. Di production wajib diisi untuk pembatasan login lintas proses.
REDIS_URL=
LANGGANIN_RUNTIME_DIR=.runtime
# Khusus Docker production; gunakan password URL-safe.
POSTGRES_PASSWORD=
# Aktifkan hanya di belakang reverse proxy HTTPS yang tepercaya.
DJANGO_TRUST_PROXY=0
